[Unit]
Description=Xabber transport backend %i
Documentation=file:/opt/xmpp-transport/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=forking
User=xabber-transport
Group=xabber-transport
WorkingDirectory=/opt/xmpp-transport

RuntimeDirectory=xabber-transport-%i
RuntimeDirectoryMode=0755
PIDFile=/run/xabber-transport-%i/xabber_transport_%i.pid

# Keep secrets outside the source checkout. Recommended permissions:
#   /etc/xabber-transport/transports.ini: root:xabber-transport 0640
ExecStart=/opt/xmpp-transport/venv/bin/xabber-transport --config /etc/xabber-transport/transports.ini --backend %i --daemon --pid-file /run/xabber-transport-%i/xabber_transport_%i.pid --daemon-workdir /opt/xmpp-transport
ExecStop=/opt/xmpp-transport/venv/bin/xabber-transport --config /etc/xabber-transport/transports.ini --backend %i --stop --pid-file /run/xabber-transport-%i/xabber_transport_%i.pid

Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=40

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/xmpp-transport/logs /run/xabber-transport-%i

[Install]
WantedBy=multi-user.target
